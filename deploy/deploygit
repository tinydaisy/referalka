#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
# ПЛЮСОН — накат ГОТОВОЙ сборки с GitHub. Команда: deploygit
#
# Чем отличается от `deploy`:
#
#   deploy      — собирает кабинет и Mini App ПРЯМО НА ПРОДЕ (2–5 минут).
#                 Сборка идёт поверх работающей папки: Next.js читает файлы,
#                 которые в этот момент переписывают, — отсюда ошибки у людей
#                 и «сайт шатает». Плюс на 4 ГБ памяти приходится гасить
#                 Celery, чтобы не словить нехватку памяти.
#
#   deploygit   — НИЧЕГО не собирает. Забирает готовую сборку, которую сделал
#                 GitHub, раскладывает её РЯДОМ со старой и переключает.
#                 Секунды вместо минут, Celery не гасим, сломанный код до
#                 прода не доедет — сборка упадёт ещё на GitHub.
#
# Когда какую: обычно deploygit. deploy — если GitHub недоступен и выкатить
# надо здесь и сейчас.
#
# ⚠️ Сборку на GitHub запускает пуш в main. Если её ещё нет или она идёт —
# команда честно скажет об этом и подождёт, а не выкатит вчерашнюю.
#
# Запуск:  deploygit           — последняя сборка ветки main
#          deploygit --wait    — дождаться, если сборка ещё идёт
# ═══════════════════════════════════════════════════════════════════════════
set -e

REPO="tinydaisy/referalka"
BRANCH="main"
WORKFLOW="Сборка"
PROJECT="/var/www/plusson"
TOKEN_FILE="/root/.github_token"

WAIT=0
LAST=0
for a in "$@"; do
  [ "$a" = "--wait" ] && WAIT=1
  # --last: выкатить последнюю успешную сборку, даже если она не самого свежего
  # коммита. Нужно, когда сборка нового коммита упала, а откатиться на рабочее
  # надо прямо сейчас.
  [ "$a" = "--last" ] && LAST=1
done

# ── Токен для GitHub ───────────────────────────────────────────────────────
# ⚠️ Артефакты сборки скачиваются только с токеном — публичного адреса у них
# нет. Лежит отдельным файлом, чтобы не хранить его в репозитории.
if [ ! -f "$TOKEN_FILE" ]; then
  echo "❌ Нет токена GitHub: $TOKEN_FILE"
  echo "   Создайте его строкой вида:  echo 'ghp_ваш_токен' > $TOKEN_FILE && chmod 600 $TOKEN_FILE"
  exit 1
fi
TOKEN=$(tr -d '[:space:]' < "$TOKEN_FILE")

api() { curl -sS -H "Authorization: token $TOKEN" \
             -H "Accept: application/vnd.github+json" "$@"; }

echo "══════ НАКАТ СБОРКИ С GITHUB ══════"

# ── 1. Ищем сборку ─────────────────────────────────────────────────────────
# Берём последний ПРОШЕДШИЙ прогон сборки ветки main. Упавшие и идущие
# пропускаем: выкатывать недособранное нельзя.
# ⚠️⚠️ ЦЕЛЬ — СБОРКА ПОСЛЕДНЕГО КОММИТА main, а не «последняя успешная».
# Раньше бралась просто свежайшая успешная. Сразу после пуша прогона нового
# коммита ещё нет в списке — и команда молча выкатывала ПРЕДЫДУЩИЙ, отвечая
# «Деплой завершён успешно». Поймано 26.08: правка ушла в git, деплой отчитался
# успехом, на сайте её не было. Теперь ищем прогон ИМЕННО нужного коммита.
TARGET=""
if [ "$LAST" = "0" ]; then
  TARGET="$(cd "$PROJECT" && git ls-remote origin "refs/heads/$BRANCH" 2>/dev/null | cut -f1)"
  TARGET="${TARGET:0:8}"
fi

find_run() {   # $1 — коммит (8 символов) или пусто = любой последний
  api "https://api.github.com/repos/$REPO/actions/runs?branch=$BRANCH&per_page=30" |
  python3 -c "
import json,sys
want = '$1'
runs = json.load(sys.stdin).get('workflow_runs', [])
for r in runs:
    if r['name'] != '$WORKFLOW':
        continue
    if want and not r['head_sha'].startswith(want):
        continue
    print(r['id'], r['status'], r['conclusion'] or '-', r['head_sha'][:8])
    break
"
}

INFO=$(find_run "$TARGET")

# Прогона нужного коммита ещё нет — GitHub его не завёл (пуш только что) или
# сборка отключена. С --wait ждём появления, без него честно говорим.
if [ -z "$INFO" ] && [ -n "$TARGET" ]; then
  if [ "$WAIT" = "1" ]; then
    echo "► Сборка коммита $TARGET ещё не началась. Жду..."
    for _ in $(seq 1 40); do          # до 10 минут
      sleep 15
      INFO=$(find_run "$TARGET")
      [ -n "$INFO" ] && break
    done
  fi
  if [ -z "$INFO" ]; then
    echo "⚠️ Сборки последнего коммита ($TARGET) на GitHub ещё нет."
    echo "   Подождите минуту и запустите:  deploygit --wait"
    echo "   Выкатить предыдущую готовую сборку (без вашего коммита):  deploygit --last"
    exit 1
  fi
fi

# --last — осознанно взять последнюю успешную, какой бы она ни была.
if [ -z "$INFO" ]; then
  INFO=$(find_run "")
  [ -z "$INFO" ] && { echo "❌ Сборок ветки $BRANCH не найдено."; exit 1; }
fi
read -r RUN_ID STATUS CONCL SHA <<< "$INFO"

if [ "$STATUS" != "completed" ]; then
  if [ "$WAIT" = "1" ]; then
    echo "► Сборка ещё идёт ($SHA). Жду..."
    while [ "$STATUS" != "completed" ]; do
      sleep 15
      read -r RUN_ID STATUS CONCL SHA <<< "$(find_run "$SHA")"
    done
  else
    echo "⚠️ Сборка ещё идёт ($SHA). Подождите пару минут или запустите:  deploygit --wait"
    exit 1
  fi
fi

# ⚠️ Выкатываем НЕ последний коммит — говорим об этом вслух. Молчаливая выкатка
# «почти свежего» и есть та ошибка, из-за которой правку считали задеплоенной.
if [ -n "$TARGET" ] && [ "$SHA" != "$TARGET" ]; then
  echo "⚠️ ВНИМАНИЕ: выкатывается $SHA, а последний коммит в $BRANCH — $TARGET."
  echo "   Правок из $TARGET на проде НЕ БУДЕТ."
fi

if [ "$CONCL" != "success" ]; then
  echo "❌ Последняя сборка не прошла ($SHA, итог: $CONCL)."
  echo "   Прод остаётся на прежней версии. Смотрите ошибку в GitHub → Actions."
  exit 1
fi

echo "► Сборка найдена: коммит $SHA"

# Уже стоит? Тогда и качать нечего.
#
# ⚠️ Сверяемся с отметкой, которую пишет release.sh ПОСЛЕ успешного наката, а
# НЕ с git HEAD. По HEAD судить нельзя: коммит часто делают прямо на сервере —
# тогда HEAD уже новый, а разложенная сборка в web/.next ещё старая, и команда
# отвечала «уже на проде», хотя правка до людей не доехала (поймано 26.08.2026
# на правке названия пункта в Настройках). Отметки нет вовсе — считаем, что
# версия неизвестна, и катим: лишний накат безвреден, пропущенный — нет.
CURRENT=$(cat "$PROJECT/.deployed_sha" 2>/dev/null | tr -d "[:space:]")
if [ -n "$CURRENT" ] && [ "$CURRENT" = "$SHA" ] && [ -f "$PROJECT/mini-app/dist/index.html" ]; then
  echo "✓ Эта сборка уже на проде — обновлять нечего."
  exit 0
fi

# ── 2. Качаем сборку ───────────────────────────────────────────────────────
# ⚠️⚠️ ДВА ИСТОЧНИКА, и релиз ПЕРВЫЙ (14.09.2026). Артефакты живут в хранилище
# с квотой 500 МБ на всю учётку; когда она кончилась, загрузка вставала, и
# выкатывать было НЕЧЕГО, хотя сборка проходила целиком. Релизы в эту квоту не
# входят, поэтому сборка едет туда. Артефакт остаётся запасным путём — для
# сборок, сделанных до этой правки.
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

echo "► Ищу сборку в релизах..."
REL_URL=$(api "https://api.github.com/repos/$REPO/releases/tags/build-$SHA" |
  python3 -c "
import json,sys
try:
    d = json.load(sys.stdin)
    for a in d.get('assets', []):
        if a['name'] == 'build.tar.gz':
            print(a['url']); break
except Exception:
    pass
")

if [ -n "$REL_URL" ]; then
  echo "► Качаю из релиза build-$SHA..."
  curl -sSL -H "Authorization: token $TOKEN" \
       -H "Accept: application/octet-stream" "$REL_URL" -o "$TMP/out_build.tar.gz"
  mkdir -p "$TMP/out" && mv "$TMP/out_build.tar.gz" "$TMP/out/build.tar.gz"
else
  echo "► В релизах нет — пробую артефакт сборки..."
  ART_URL=$(api "https://api.github.com/repos/$REPO/actions/runs/$RUN_ID/artifacts" |
    python3 -c "
import json,sys
for a in json.load(sys.stdin).get('artifacts', []):
    if a['name'] == 'build' and not a['expired']:
        print(a['archive_download_url']); break
")
  [ -z "$ART_URL" ] && {
    echo "❌ Готовой сборки нет ни в релизах, ни в артефактах."
    echo "   Причина обычно одна: квота артефактов (500 МБ на учётку) —"
    echo "   тогда прогон зелёный, а файла нет. Перезапустите сборку в Actions"
    echo "   (она положит её в релиз) или выкатите командой:  deploy"
    exit 1
  }
  curl -sSL -H "Authorization: token $TOKEN" "$ART_URL" -o "$TMP/build.zip"
  unzip -q "$TMP/build.zip" -d "$TMP/out"
fi

# Внутри — build.tar.gz, тот самый архив, который ждёт release.sh
[ -f "$TMP/out/build.tar.gz" ] || {
  echo "❌ В сборке нет ожидаемого архива — формат изменился."
  exit 1
}

SIZE=$(du -h "$TMP/out/build.tar.gz" | cut -f1)
echo "► Скачано: $SIZE"

# ── 3. Раскладываем ────────────────────────────────────────────────────────
# ⚠️ Всю дальнейшую работу делает release.sh: он раскладывает сборку рядом со
# старой, переключает ссылку, накатывает миграции, рестартует только то, чей
# код менялся, и откатывается, если сайт не ответил. Здесь мы её только
# доставили — дублировать эту логику нельзя, она разъедется.
exec bash "$PROJECT/deploy/release.sh" "$TMP/out/build.tar.gz" "$SHA"
