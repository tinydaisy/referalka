[Unit]
# Ночной накат отложенной сборки. Ставится кнопкой «ночью в 04:00 МСК»
# в GitHub Actions: сборка кладётся в /var/www/plusson/pending и ждёт здесь.
Description=PLUSSON: накат отложенной сборки
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if [ -f /var/www/plusson/pending/build.tar.gz ]; then \
  SHA=$$(cat /var/www/plusson/pending/COMMIT 2>/dev/null || echo manual); \
  mv /var/www/plusson/pending/build.tar.gz /tmp/pending_build.tar.gz; \
  rm -f /var/www/plusson/pending/COMMIT; \
  /var/www/plusson/deploy/release.sh /tmp/pending_build.tar.gz "$$SHA"; \
fi'
StandardOutput=journal
StandardError=journal
