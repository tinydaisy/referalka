[Unit]
Description=PLUSSON: ночной накат отложенной сборки (04:00 МСК)

[Timer]
# 04:00 по Москве. Время указано явно с зоной — сервер живёт в UTC,
# и без этого накат уехал бы на 07:00 МСК.
OnCalendar=*-*-* 04:00:00 Europe/Moscow
# Сервер был выключен в 04:00 → выкатить при первой возможности,
# а не пропустить до следующих суток.
Persistent=true

[Install]
WantedBy=timers.target
