-- 486: ВЕРНУТЬ ОБРАТНО фото спикеров, выбранные под событие.
-- Отменяет временную миграцию 485.
--
-- ⚠️⚠️ ФАЙЛ ЛЕЖИТ НЕ В `db/migrations/` И С СУФФИКСОМ `.ready` — СПЕЦИАЛЬНО.
-- `deploy/migrate.sh` накатывает ВСЁ, что лежит в `db/migrations`, по имени
-- файла. Положи этот файл туда сейчас — и первый же деплой отменит правку,
-- которую владелец просил держать до отдельной команды.
--
-- ЧТОБЫ ВЕРНУТЬ (когда владелец скажет «верни обратно»):
--     git mv db/pending/486_restore_event_photo_id.sql.ready \
--            db/migrations/486_restore_event_photo_id.sql
--   → коммит → пуш → `deploygit` на проде.
--
-- Восстанавливает выбор из снимка, снятого миграцией 485. Спикеры, у которых
-- выбора не было, так и останутся на профильном фото — их в снимке нет.

BEGIN;

-- ⚠️ Возвращаем ТОЛЬКО тем, у кого сейчас пусто. Если за время паузы владелец
-- выбрал кому-то фото заново, его свежий выбор важнее сохранённого старого —
-- перетирать вручную сделанное нельзя.
UPDATE event_collaborators ec
   SET photo_id = b.photo_id
  FROM event_collaborators_photo_id_backup b
 WHERE b.event_collaborator_id = ec.id
   AND ec.photo_id IS NULL
   -- ⚠️ Фото могли удалить из библиотеки за это время: ссылка на
   -- несуществующую строку упрётся во внешний ключ и уронит всю миграцию.
   AND EXISTS (SELECT 1 FROM collaborator_photos cp WHERE cp.id = b.photo_id);

DROP TABLE IF EXISTS event_collaborators_photo_id_backup;

COMMIT;
